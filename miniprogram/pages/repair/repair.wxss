page { background-color: #f0f2f5; }
.page { height: 100vh; display: flex; flex-direction: column; }
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1px solid #e4e7ed;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 12px 0;
  font-size: 15px;
  color: #909399;
  position: relative;
}
.tab-item.active {
  color: #409EFF;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 2px;
  background: #409EFF;
}
.list-scroll, .form-scroll {
  flex: 1;
  overflow-y: auto;
}
.repair-card { margin: 8px 16px; }
.repair-order { font-size: 13px; font-weight: 500; color: #303133; }
.repair-desc {
  display: block;
  font-size: 13px;
  color: #606266;
  margin-top: 6px;
  line-height: 1.5;
}
.line-clamp-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.empty-state { text-align: center; padding: 60px 16px; }
.form-field {
  padding: 12px 0;
  border-bottom: 1px solid #f2f2f2;
  display: flex;
  align-items: center;
  min-height: 44px;
}
.form-label { width: 80px; color: #606266; font-size: 14px; flex-shrink: 0; }
.form-value { flex: 1; color: #303133; font-size: 14px; text-align: right; }
.form-value.placeholder { color: #c0c4cc; }
.arrow { color: #c0c4cc; font-size: 20px; margin-left: 4px; }
.radio-group { display: flex; gap: 8px; flex: 1; justify-content: flex-end; }
.radio-item {
  padding: 4px 12px;
  border: 1px solid #dcdfe6;
  border-radius: 4px;
  font-size: 13px;
  color: #606266;
}
.radio-item.radio-active {
  border-color: #409EFF;
  color: #409EFF;
  background: #ecf5ff;
}
.form-textarea {
  flex: 1;
  min-height: 80px;
  font-size: 14px;
  padding: 8px;
  border: 1px solid #dcdfe6;
  border-radius: 4px;
  background: #fafafa;
}
.photo-grid { display: flex; flex-wrap: wrap; gap: 8px; flex: 1; justify-content: flex-end; }
.photo-item { position: relative; width: 72px; height: 72px; }
.photo-thumb { width: 100%; height: 100%; border-radius: 4px; object-fit: cover; }
.photo-del {
  position: absolute;
  top: -6px;
  right: -6px;
  width: 20px;
  height: 20px;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 20px;
  font-size: 12px;
}
.photo-add {
  width: 72px;
  height: 72px;
  border: 1px dashed #dcdfe6;
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.btn-primary {
  background: #409EFF;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 12px 0;
  font-size: 16px;
  width: 100%;
  margin-top: 20px;
}
.fab {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 56px;
  height: 56px;
  background: #409EFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(64,158,255,0.4);
  z-index: 100;
}
.voice-row { display: flex; gap: 8px; flex: 1; justify-content: flex-end; flex-wrap: wrap; }
.voice-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 14px;
  border: 1px solid #dcdfe6;
  border-radius: 20px;
  font-size: 13px;
  color: #606266;
  background: #fff;
}
.voice-btn-recording { border-color: #F56C6C; color: #F56C6C; background: #fef0f0; }
.voice-btn-play { border-color: #67C23A; color: #67C23A; }
.voice-btn-clear { border-color: #909399; color: #909399; }
.voice-icon {
  width: 22px;
  height: 22px;
  line-height: 22px;
  text-align: center;
  border-radius: 50%;
  font-size: 12px;
  font-weight: 600;
  color: #fff;
  display: inline-block;
}
.voice-icon-rec { background: #409EFF; }
.voice-icon-stop { background: #F56C6C; }
.voice-icon-play { background: #67C23A; }
.voice-icon-del { background: #909399; }
.voice-text { font-size: 13px; }
.offline-badge {
  position: fixed;
  bottom: 90px;
  left: 50%;
  transform: translateX(-50%);
  background: #E6A23C;
  color: #fff;
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 13px;
  z-index: 99;
  box-shadow: 0 2px 8px rgba(230,162,60,0.4);
}
.offline-badge-text { color: #fff; }

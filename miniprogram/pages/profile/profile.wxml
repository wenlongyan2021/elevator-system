<view class="page">
  <!-- Login form (when not logged in) -->
  <view wx:if="{{!loggedIn}}" class="container">
    <view class="card">
      <text class="card-title">登录</text>
      <view class="form-field">
        <text class="form-label">手机号</text>
        <input class="form-input" placeholder="请输入手机号" type="text" maxlength="11" bindinput="onPhoneInput" value="{{phone}}" />
      </view>
      <view class="form-field">
        <text class="form-label">密码</text>
        <input class="form-input" placeholder="请输入密码" type="password" bindinput="onPasswordInput" value="{{password}}" />
      </view>
      <button class="btn-primary" bindtap="handleLogin" loading="{{logging}}" disabled="{{logging}}">
        登录
      </button>
      <text class="text-secondary hint-text">建议使用微信授权登录（后续版本支持）</text>
    </view>
  </view>

  <!-- User profile (when logged in) -->
  <view wx:if="{{loggedIn}}" class="container">
    <view class="user-header card">
      <view class="avatar">
        <text class="avatar-text">{{avatarLetter}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo?.name || '用户'}}</text>
        <text class="user-phone">{{userInfo?.phone || ''}}</text>
      </view>
    </view>

    <view class="card">
      <view class="menu-item" bindtap="goNotifications">
        <view class="menu-left">
          <text>消息通知</text>
          <text wx:if="{{unreadCount > 0}}" class="unread-badge">{{unreadCount}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMaintenancePlan">
        <view class="menu-left">
          <text>维保计划</text>
        </view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="viewProfile">
        <text>个人信息</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item">
        <text>角色</text>
        <text class="text-secondary">{{roleText}}</text>
      </view>
      <view class="menu-item">
        <text>版本</text>
        <text class="text-secondary">1.0.0</text>
      </view>
    </view>

    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>
</view>

page { background-color: #f0f2f5; }
.page { height: 100vh; }
.container { padding: 16px; }
.empty-state { text-align: center; padding: 60px 16px; }
.status-header { display: flex; justify-content: space-between; align-items: center; }
.elevator-title { font-size: 18px; font-weight: 700; color: #303133; flex: 1; word-break: break-all; }
.info-row {
  display: flex;
  padding: 10px 0;
  border-bottom: 1px solid #f2f2f2;
}
.info-row:last-child { border-bottom: none; }
.info-label { width: 100px; color: #909399; font-size: 14px; flex-shrink: 0; }
.info-value { flex: 1; color: #303133; font-size: 14px; text-align: right; }
.action-bar { padding: 20px 0 40px; }
.btn-primary {
  background: #409EFF;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 12px 0;
  font-size: 16px;
  width: 100%;
}

page { background-color: #f0f2f5; }
.page { height: 100vh; }
.container { padding: 16px; }
.empty-state { text-align: center; padding: 24px 0; }
.btn-primary {
  background: #409EFF;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 12px 0;
  font-size: 16px;
  width: 100%;
}
.record-item {
  padding: 12px 0;
  border-bottom: 1px solid #f2f2f2;
}
.record-item:last-child { border-bottom: none; }
.record-label { font-size: 14px; color: #303133; font-weight: 500; }
.record-photos { display: flex; gap: 6px; margin-top: 8px; overflow-x: auto; }
.record-photo { width: 80px; height: 80px; border-radius: 4px; flex-shrink: 0; }

page {
  background-color: #f0f2f5;
}
.page {
  height: 100vh;
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: #fff;
}
.search-input {
  flex: 1;
  height: 36px;
  background: #f0f2f5;
  border-radius: 18px;
  padding: 0 14px;
  font-size: 14px;
  color: #303133;
}
.search-btn {
  color: #409EFF;
  font-size: 14px;
  padding: 4px 8px;
}
.filter-bar {
  display: flex;
  gap: 0;
  background: #fff;
  padding: 0 16px 10px;
  border-bottom: 1px solid #f2f2f2;
}
.filter-item {
  padding: 4px 12px;
  font-size: 13px;
  color: #606266;
  border-radius: 14px;
  margin-right: 8px;
}
.filter-item.active {
  background: #ecf5ff;
  color: #409EFF;
  font-weight: 500;
}
.elevator-item {
  margin: 8px 16px;
  padding: 14px;
}
.elevator-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.elevator-code {
  font-size: 16px;
  font-weight: 600;
  color: #303133;
}
.elevator-info {
  margin-bottom: 8px;
}
.info-line {
  display: block;
  font-size: 13px;
  color: #606266;
  line-height: 1.8;
}
.elevator-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.arrow {
  color: #c0c4cc;
  font-size: 20px;
}
.loading-state, .load-more {
  text-align: center;
  padding: 20px 0;
}
.empty-state {
  margin: 16px;
  text-align: center;
  padding: 40px 0;
}

page {
  background-color: #f0f2f5;
}
.page {
  height: 100vh;
}
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: #fff;
}
.header-title {
  font-size: 17px;
  font-weight: 600;
  color: #303133;
}
.header-notif {
  position: relative;
  padding: 4px;
}
.notif-icon {
  width: 32px;
  height: 32px;
  line-height: 32px;
  text-align: center;
  border-radius: 50%;
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  display: inline-block;
}
.notif-icon-bell {
  background: #409EFF;
}
.notif-badge {
  position: absolute;
  top: -2px;
  right: -6px;
  background: #f56c6c;
  color: #fff;
  font-size: 10px;
  padding: 1px 5px;
  border-radius: 10px;
  min-width: 16px;
  text-align: center;
  line-height: 1.4;
}
.login-prompt {
  text-align: center;
  padding: 40px 16px;
}
.prompt-text {
  display: block;
  margin-bottom: 20px;
  color: #909399;
  font-size: 15px;
}
.btn-primary {
  background: #409EFF;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 10px 32px;
  font-size: 15px;
}
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 12px 16px 0;
}
.stat-item {
  flex: 1;
  min-width: calc(50% - 8px);
  text-align: center;
  padding: 16px 8px;
}
.stat-value {
  display: block;
  font-size: 28px;
  font-weight: 700;
}
.stat-label {
  display: block;
  font-size: 13px;
  color: #909399;
  margin-top: 4px;
}
.quick-actions {
  margin: 0 16px;
}
.action-row {
  display: flex;
  justify-content: space-around;
}
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8px 0;
}
.action-icon {
  width: 44px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 50%;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 4px;
  color: #fff;
}
.action-scan { background: #409EFF; }
.action-repair { background: #e6a23c; }
.action-list { background: #67c23a; }
.action-inspect { background: #909399; }
.action-refresh { background: #f56c6c; }
.action-text {
  font-size: 12px;
  color: #606266;
}
.empty-state {
  text-align: center;
  padding: 24px 0;
}
.repair-item {
  padding: 10px 0;
  border-bottom: 1px solid #f2f2f2;
}
.repair-item:last-child {
  border-bottom: none;
}
.repair-order {
  font-size: 13px;
  font-weight: 500;
  color: #303133;
}
.repair-desc {
  display: block;
  font-size: 13px;
  color: #606266;
  margin: 4px 0;
}
.line-clamp {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

# ==========================================
# Elevator System API - Environment Variables
# ==========================================
# Copy this to .env and adjust for local dev.

# --- Database ---
DATABASE_URL="postgresql://elevator:elevator_pass_2024@localhost:5432/elevator_system"

# --- JWT ---
JWT_SECRET="change_this_to_a_random_secret"

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Redis (optional — cache degrades gracefully when unavailable) ---
# REDIS_URL="redis://:redis_pass_2024@localhost:6379"

# --- Upload paths ---
# UPLOAD_PATH="./uploads"
# QR_URL_PREFIX="/uploads/qrcodes"

# --- Scheduled task windows (days) ---
# INSPECTION_WINDOW_DAYS=30
# CONTRACT_WINDOW_DAYS=30
# MAINTENANCE_PLAN_WINDOW_DAYS=7

# --- Docker compose uses these (not .env) ---
# DB_PASSWORD=elevator_pass_2024
# REDIS_PASSWORD=redis_pass_2024
